FROM quay.io/pypa/manylinux_2_28_aarch64:latest

RUN yum check-update | exit 0 && yum install -y ninja-build clang

RUN mkdir /py_env && mkdir /fdt_build

RUN /opt/python/cp312-cp312/bin/python3 -m venv /py_env/env312 && \
    . /py_env/env312/bin/activate && \
    pip install -U pip build auditwheel && \
    deactivate

RUN /opt/python/cp313-cp313/bin/python3 -m venv /py_env/env313 && \
    . /py_env/env313/bin/activate && \
    pip install -U pip build auditwheel && \
    deactivate

RUN /opt/python/cp314-cp314/bin/python3 -m venv /py_env/env314 && \
    . /py_env/env314/bin/activate && \
    pip install -U pip build auditwheel && \
    deactivate

RUN /opt/python/cp314-cp314t/bin/python3 -m venv /py_env/env314t && \
    . /py_env/env314t/bin/activate && \
    pip install -U pip build auditwheel && \
    deactivate

RUN /opt/python/cp315-cp315/bin/python3 -m venv /py_env/env315 && \
    . /py_env/env315/bin/activate && \
    pip install -U pip build auditwheel && \
    deactivate

RUN /opt/python/cp315-cp315t/bin/python3 -m venv /py_env/env315t && \
    . /py_env/env315t/bin/activate && \
    pip install -U pip build auditwheel && \
    deactivate

ENV CC=clang
ENV CXX=clang++

WORKDIR /fdt_build

CMD ["./build_scripts/linux_build.sh"]
